# Application
SECRET_KEY=your-secret-key-change-this-in-production
APP_NAME=SIM Card Management
DEBUG=True

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./simcard.db
# DATABASE_URL=postgresql://user:password@host:5432/simcard_db

# Email Notification (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=karndiy@email.com
SMTP_PASSWORD=your-app-password
NOTIFY_EMAIL=admin@yourcompany.com

# Line Notify
LINE_NOTIFY_TOKEN=your-line-notify-token

# Alert Settings (days before expiry)
ALERT_DAYS_BEFORE=7,14,30
